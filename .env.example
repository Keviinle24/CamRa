# Copy to .env.local and fill in the values.

# MongoDB connection string (MongoDB Atlas or a local mongod).
MONGODB_URI=mongodb://127.0.0.1:27017/camra

# Secret used to sign session cookies and call IDs.
# Generate one with: openssl rand -base64 48
JWT_SECRETKEY=

# Public URL of the site, used for links in emails and social previews.
# Defaults to the URL of the incoming request when unset.
APP_URL=http://localhost:3000

# Email for verification links: configure SMTP or Resend. In development, leave
# both empty and the verification link is printed in the terminal instead.
#
# SMTP, e.g. Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
#
# Or Resend (https://resend.com): needs a domain verified in Resend to email
# anyone other than yourself.
RESEND_API_KEY=
#
# Sender shown in the inbox. Optional with SMTP (defaults to SMTP_USER); required with Resend.
EMAIL_FROM=

# Agora (https://console.agora.io). The project needs an App Certificate and the
# Signaling (RTM) service enabled.
# (NEXT_PUBLIC_AGORA_APP_ID from the previous version is still accepted.)
AGORA_APP_ID=
AGORA_APP_CERT=
